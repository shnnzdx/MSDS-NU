    <span class="n">X_sub_tr</span><span class="p">,</span> <span class="n">X_sub_val</span><span class="p">,</span> <span class="n">y_sub_tr</span><span class="p">,</span> <span class="n">y_sub_val</span> <span class="o">=</span> <span class="n">train_test_split</span><span class="p">(</span>
